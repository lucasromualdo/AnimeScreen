<Window x:Class="Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyAnimeScreen.App.Converters"
        xmlns:models="clr-namespace:MyAnimeScreen.App.Models"
        Title="MyAnimeScreen"
        Height="700"
        Width="980"
        MinHeight="560"
        MinWidth="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:AnimeStatusToTextConverter x:Key="AnimeStatusToTextConverter" />
        <x:Array x:Key="AnimeStatusValues" Type="{x:Type models:AnimeStatus}">
            <x:Static Member="models:AnimeStatus.QueroVer" />
            <x:Static Member="models:AnimeStatus.Assistindo" />
            <x:Static Member="models:AnimeStatus.Concluido" />
            <x:Static Member="models:AnimeStatus.Pausado" />
            <x:Static Member="models:AnimeStatus.Dropado" />
        </x:Array>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="MyAnimeScreen" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,18"
                   Foreground="#555555"
                   Text="Busque animes por nome para carregar resultados da Jikan API." />

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Margin="0,0,10,0"
                     Padding="10,6"
                     FontSize="14"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    MinWidth="110"
                    Padding="14,8"
                    Command="{Binding SearchCommand}"
                    Content="Buscar" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,10"
                       Foreground="#B91C1C"
                       FontWeight="SemiBold"
                       Text="{Binding ErrorMessage}" />

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,10"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                       Text="Carregando resultados..." />

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="Resultados" />

                        <ListBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedAnime, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="#6B7280"
                                                       Text="{Binding Score, StringFormat=Nota: {0:F2}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedAnime.Title}" />

                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#6B7280"
                                       Text="{Binding SelectedAnime.TitleJp, StringFormat=Título JP: {0}}" />

                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding SelectedAnime.Score, StringFormat=Nota: {0:F2}}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedAnime.EpisodesTotal, StringFormat=Episódios: {0}}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedAnime.Year, StringFormat=Ano: {0}}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedAnime.Season, StringFormat=Temporada: {0}}" />

                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="SemiBold"
                                       Text="Sinopse" />

                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedAnime.Synopsis}" />

                            <Separator Margin="0,16,0,12" />

                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Minha Lista" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold" Text="Status" />
                                    <ComboBox Margin="0,6,0,10"
                                              ItemsSource="{StaticResource AnimeStatusValues}"
                                              SelectedItem="{Binding UserStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource AnimeStatusToTextConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock FontWeight="SemiBold" Text="Episódio atual" />
                                    <TextBox Margin="0,6,0,10"
                                             Padding="8,6"
                                             Text="{Binding CurrentEpisode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                    <CheckBox Content="Favorito"
                                              IsChecked="{Binding IsFavorite, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock FontWeight="SemiBold" Text="Nota pessoal (0-10)" />
                                    <TextBox Margin="0,6,0,10"
                                             Padding="8,6"
                                             Text="{Binding PersonalScore, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />

                                    <TextBlock FontWeight="SemiBold" Text="Notas" />
                                    <TextBox Margin="0,6,0,0"
                                             Height="88"
                                             Padding="8,6"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding UserNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Button Margin="0,12,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SaveToMyListCommand}"
                                    Content="Salvar na Minha Lista" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Biblioteca Local" />

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Filtrar por status:" />

                        <ComboBox Grid.Column="1"
                                  Height="30"
                                  ItemsSource="{StaticResource AnimeStatusValues}"
                                  SelectedItem="{Binding LibraryFilterStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AnimeStatusToTextConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Margin="10,0,0,0"
                                Padding="12,6"
                                Command="{Binding RefreshLibraryCommand}"
                                Content="Atualizar" />

                        <TextBlock Grid.Column="3"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Visibility="{Binding IsLibraryLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Text="Carregando biblioteca..." />
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding LibraryItems}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="8"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status, Converter={StaticResource AnimeStatusToTextConverter}}" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CurrentEpisode, StringFormat=Ep atual: {0}}" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PersonalScore, StringFormat=Nota: {0:F1}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
