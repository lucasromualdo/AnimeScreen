<Window x:Class="Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyAnimeScreen.App.Converters"
        xmlns:validation="clr-namespace:MyAnimeScreen.App.Validation"
        xmlns:models="clr-namespace:MyAnimeScreen.App.Models"
        Title="MyAnimeScreen"
        Height="700"
        Width="980"
        MinHeight="560"
        MinWidth="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:AnimeStatusToTextConverter x:Key="AnimeStatusToTextConverter" />
        <converters:ImageUrlToBitmapImageConverter x:Key="ImageUrlToBitmapImageConverter" />
        <x:Array x:Key="AnimeStatusValues" Type="{x:Type models:AnimeStatus}">
            <x:Static Member="models:AnimeStatus.QueroVer" />
            <x:Static Member="models:AnimeStatus.Assistindo" />
            <x:Static Member="models:AnimeStatus.Concluido" />
            <x:Static Member="models:AnimeStatus.Pausado" />
            <x:Static Member="models:AnimeStatus.Dropado" />
        </x:Array>
        <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="MyAnimeScreen" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,18"
                   Foreground="#555555"
                   Text="Busque animes por nome para carregar resultados da Jikan API." />

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Margin="0,0,10,0"
                     Padding="10,6"
                     FontSize="14"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    MinWidth="110"
                    Padding="14,8"
                    Command="{Binding SearchCommand}"
                    Content="Buscar" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,10"
                       Foreground="#B91C1C"
                       FontWeight="SemiBold"
                       Text="{Binding ErrorMessage}" />

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="Carregando resultados..." />

                <TextBlock FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Visibility="{Binding IsSavingToMyList, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="Salvando na Minha Lista..." />

                <TextBlock FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Visibility="{Binding IsRemovingFromMyList, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="Removendo da Minha Lista..." />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="Resultados" />

                        <ListBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedAnime, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="56"
                                                    Height="80"
                                                    Background="#F3F4F6"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#6B7280"
                                                               Text="Sem capa" />

                                                    <Image x:Name="ResultCoverImage"
                                                           DataContextChanged="OnCoverImageDataContextChanged"
                                                           ImageFailed="OnCoverImageFailed"
                                                           Stretch="UniformToFill"
                                                           Source="{Binding ImageUrl, Converter={StaticResource ImageUrlToBitmapImageConverter}, ConverterParameter=112}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Title}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="12"
                                                           Foreground="#6B7280"
                                                           Text="{Binding Score, StringFormat=Nota: {0:F2}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Width="180"
                                    Height="256"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Left"
                                    Background="#F3F4F6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#6B7280"
                                               Text="Sem capa&#10;(offline)" />

                                    <Image x:Name="DetailCoverImage"
                                           DataContextChanged="OnCoverImageDataContextChanged"
                                           ImageFailed="OnCoverImageFailed"
                                           Stretch="UniformToFill"
                                           Source="{Binding SelectedAnime.ImageUrl, Converter={StaticResource ImageUrlToBitmapImageConverter}, ConverterParameter=360}" />
                                </Grid>
                            </Border>

                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedAnime.Title}" />

                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#6B7280"
                                       Text="{Binding SelectedAnime.TitleJp, StringFormat=Título JP: {0}}" />

                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding SelectedAnime.Score, StringFormat=Nota: {0:F2}}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedAnime.EpisodesTotal, StringFormat=Episódios: {0}}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedAnime.Year, StringFormat=Ano: {0}}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedAnime.Season, StringFormat=Temporada: {0}}" />

                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="SemiBold"
                                       Text="Sinopse" />

                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedAnime.Synopsis}" />

                            <Separator Margin="0,16,0,12" />

                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Minha Lista" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold" Text="Status" />
                                    <ComboBox Margin="0,6,0,10"
                                              ItemsSource="{StaticResource AnimeStatusValues}"
                                              SelectedItem="{Binding UserStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource AnimeStatusToTextConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock FontWeight="SemiBold" Text="Episódio atual" />
                                    <TextBox Margin="0,6,0,10"
                                             Padding="8,6"
                                             Style="{StaticResource ValidatedTextBoxStyle}">
                                        <TextBox.Text>
                                            <Binding Path="CurrentEpisode"
                                                     Mode="TwoWay"
                                                     UpdateSourceTrigger="PropertyChanged"
                                                     NotifyOnValidationError="True"
                                                     ValidatesOnExceptions="True">
                                                <Binding.ValidationRules>
                                                    <validation:NonNegativeIntegerValidationRule ValidationStep="RawProposedValue" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>

                                    <CheckBox Content="Favorito"
                                              IsChecked="{Binding IsFavorite, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock FontWeight="SemiBold" Text="Nota pessoal (0-10)" />
                                    <TextBox Margin="0,6,0,10"
                                             Padding="8,6"
                                             Style="{StaticResource ValidatedTextBoxStyle}">
                                        <TextBox.Text>
                                            <Binding Path="PersonalScore"
                                                     Mode="TwoWay"
                                                     UpdateSourceTrigger="PropertyChanged"
                                                     NotifyOnValidationError="True"
                                                     ValidatesOnExceptions="True"
                                                     TargetNullValue="">
                                                <Binding.ValidationRules>
                                                    <validation:PersonalScoreValidationRule ValidationStep="RawProposedValue" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>

                                    <TextBlock FontWeight="SemiBold" Text="Notas" />
                                    <TextBox Margin="0,6,0,0"
                                             Height="88"
                                             Padding="8,6"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding UserNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0"
                                        Orientation="Horizontal">
                                <Button Padding="12,8"
                                        HorizontalAlignment="Left"
                                        Command="{Binding SaveToMyListCommand}"
                                        Content="Salvar na Minha Lista" />

                                <Button Margin="10,0,0,0"
                                        Padding="12,8"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RemoveFromMyListCommand}"
                                        Content="Remover da Minha Lista" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Biblioteca Local" />

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Filtrar por status:" />

                        <ComboBox Grid.Column="1"
                                  Height="30"
                                  ItemsSource="{Binding LibraryFilterOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Status"
                                  SelectedValue="{Binding LibraryFilterStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column="2"
                                   Margin="12,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Filtrar por genero:" />

                        <ComboBox Grid.Column="3"
                                  Height="30"
                                  ItemsSource="{Binding LibraryGenreOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="GenreName"
                                  SelectedValue="{Binding LibraryFilterGenre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column="4"
                                   Margin="12,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Ordenar por:" />

                        <ComboBox Grid.Column="5"
                                  Height="30"
                                  ItemsSource="{Binding LibrarySortOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="SortBy"
                                  SelectedValue="{Binding LibrarySortBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="6"
                                Margin="10,0,0,0"
                                Padding="12,6"
                                Command="{Binding RefreshLibraryCommand}"
                                Content="Atualizar" />

                        <TextBlock Grid.Column="7"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Visibility="{Binding IsLibraryLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Text="Carregando biblioteca..." />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding LibraryItems}"
                                 SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding LibraryItems.Count}" Value="0" />
                                                <Condition Binding="{Binding IsLibraryLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E0F2FE" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            BorderBrush="#BFDBFE"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Title}" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="#B45309"
                                                           FontWeight="Bold"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Text="★" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Status, Converter={StaticResource AnimeStatusToTextConverter}}" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding CurrentEpisode, StringFormat=Ep atual: {0}}" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding PersonalScore, StringFormat=Nota: {0:F1}}" />

                                            <Button Grid.Column="4"
                                                    Margin="10,0,0,0"
                                                    Padding="10,4"
                                                    Command="{Binding DataContext.OpenLibraryItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Abrir" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Text="Nenhum anime salvo para este filtro."
                                   Visibility="Collapsed">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding LibraryItems.Count}" Value="0" />
                                                <Condition Binding="{Binding IsLibraryLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
